{
  "author": "codecbyfj",
  "manifest_version": 3,
  "name": "Tracking Work Hours",
  "version": "1.0",
  "host_permissions": [
    "https://corp.arsenaltech.com/*",
    "http://corp.arsenaltech.com/*"
  ],
  "icons": {
    "16": "alarm-clock16.png",
    "32": "alarm-clock32.png",
    "64": "alarm-clock64.png",
    "128": "alarm-clock128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://corp.arsenaltech.com/ems/*",
        "http://corp.arsenaltech.com/ems/*"
      ],
      "exclude_matches": [
        "https://corp.arsenaltech.com/ems/welcome/index*",
        "http://corp.arsenaltech.com/ems/welcome/index*",
        "https://corp.arsenaltech.com/ems/welcome/password*",
        "http://corp.arsenaltech.com/ems/welcome/password*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}